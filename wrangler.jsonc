{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-gmz",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f8f205b0-bc22-4702-9945-11a6e68aba6f","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b66a50b7018e4271a40ad7015db72247" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
